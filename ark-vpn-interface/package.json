    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
